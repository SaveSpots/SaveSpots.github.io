NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Square (donations) -------------------------------------------------
# Server-only. Never prefix these with NEXT_PUBLIC_ — that would ship the
# access token to every browser that loads the site.
# Square Dashboard > Developer > Applications > your app > Credentials.
SQUARE_ACCESS_TOKEN=your-square-access-token
# Square Dashboard > Developer > Applications > your app > Locations.
SQUARE_LOCATION_ID=your-square-location-id
# "production" charges real cards. Anything else (or unset) uses sandbox.
SQUARE_ENVIRONMENT=sandbox

# --- Donation receipts pipeline ---
# Square Dashboard > Developer > Webhooks (or created via the API). Signs the
# webhook payload; without it every delivery is rejected as unsigned.
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
# Must match the subscription's notification_url EXACTLY — it is part of the
# signed string, so a mismatch makes every signature fail.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://savespots.org/api/donate/webhook
# Supabase Dashboard > Settings > API. Bypasses RLS — server-only, never
# prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Resend API key used to send contribution acknowledgments.
RESEND_API_KEY=your-resend-api-key
